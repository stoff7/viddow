{
  "manifest_version": 3,
  "name": "Viddow — видео под рукой",
  "version": "3.4.0",
  "minimum_chrome_version": "116",
  "description": "Скачивание видео со страницы и по ссылке, найденные потоки, очередь и настройки в боковой панели.",
  "permissions": ["webRequest", "storage", "nativeMessaging", "sidePanel", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "popup.html" },
  "action": { "default_title": "Открыть Viddow" }
}
